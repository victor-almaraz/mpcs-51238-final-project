<!doctype html>
<!-- The GUI editor's page (tauri-editor.md §5). CMake writes index.html from
     this file, with the import map of the packages in cmake/EditorWeb.cmake. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>espresso</title>
<link rel="stylesheet" href="./editor.css">
<script type="importmap">
  {
    "imports": {
@ESPRESSO_IMPORT_MAP@
    }
  }
</script>
<script type="module" src="./main.js"></script>
</head>
<body>
<main id="editor" aria-label="Editor"></main>
<footer id="status" role="status" aria-live="polite">Starting…</footer>
</body>
</html>
