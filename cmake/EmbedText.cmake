# Writes OUT, a C++ source defining NAMESPACE::FUNCTION(), which returns
# the text of IN as a std::string_view: a file served or used as it is,
# such as the page helper (io.md §12.9) and the IR schema. HEADER, when
# given, is the header that declares the function, as <HEADER>. Run with
# cmake -P; the file is rewritten only when its contents change.

set(delimiter "espresso-text")
file(READ "${IN}" text)
string(FIND "${text}" ")${delimiter}\"" clash)
if(NOT clash EQUAL -1)
    message(FATAL_ERROR "${IN} contains )${delimiter}\", which ends the literal that embeds it")
endif()
# A literal may hold at most 65536 characters (-Woverlength-strings): the
# text goes in pieces of at most 30000, each ending at a line's end so no
# character's bytes are split, joined once when the function is first called.
set(pieces "")
string(LENGTH "${text}" remaining)
set(start 0)
while(remaining GREATER 0)
    string(SUBSTRING "${text}" ${start} 30000 piece)
    string(LENGTH "${piece}" length)
    if(length LESS remaining)
        string(FIND "${piece}" "\n" last REVERSE)
        if(last GREATER -1)
            math(EXPR length "${last} + 1")
            string(SUBSTRING "${piece}" 0 ${length} piece)
        endif()
    endif()
    if(pieces STREQUAL "")
        set(pieces "std::string(R\"${delimiter}(${piece})${delimiter}\")")
    else()
        string(APPEND pieces "\n        + R\"${delimiter}(${piece})${delimiter}\"")
    endif()
    math(EXPR start "${start} + ${length}")
    math(EXPR remaining "${remaining} - ${length}")
endwhile()
if(pieces STREQUAL "")
    set(pieces "std::string()")
endif()
get_filename_component(name "${IN}" NAME)
set(declaration "")
if(HEADER)
    set(declaration "\n#include <${HEADER}>\n")
endif()
file(WRITE "${OUT}.tmp"
"// Generated by cmake/EmbedText.cmake from ${name}; do not edit.

#include <string>
#include <string_view>
${declaration}
namespace ${NAMESPACE} {

std::string_view ${FUNCTION}() noexcept {
    static const std::string text = ${pieces};
    return text;
}

} // namespace ${NAMESPACE}
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
