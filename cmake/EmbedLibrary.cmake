# Writes OUT, a C++ source that holds each file of FILES, paths under
# ROOT, as a string literal: the standard library compiled into the
# interpreter. Run with cmake -P; the file is rewritten only when its
# contents change, so an unchanged library rebuilds nothing.

set(delimiter "espresso-lisp")
set(body "")
foreach(path IN LISTS FILES)
    file(RELATIVE_PATH name "${ROOT}" "${path}")
    file(READ "${path}" text)
    string(FIND "${text}" ")${delimiter}\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${name} contains )${delimiter}\", which ends the literal that embeds it")
    endif()
    string(APPEND body "    libraryFile{.path = \"${name}\", .text = R\"${delimiter}(${text})${delimiter}\"},\n")
endforeach()

file(WRITE "${OUT}.tmp"
"// Generated by cmake/EmbedLibrary.cmake from lib/; do not edit.

#include <array>
#include <span>

#include \"standardLibrary.h\"

namespace interpreter::detail {

namespace {

constexpr std::array files{
${body}};

} // namespace

std::span<const libraryFile> standardLibrary() { return files; }

} // namespace interpreter::detail
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
