# Static analysis for the modern-cpp skill. Silence a finding only at a
# site listed in the skill's section 9: // NOLINT(check): reason
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-pro-bounds-pointer-arithmetic,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-reinterpret-cast,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-include-cleaner,
  misc-redundant-expression,
  misc-unused-using-decls,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  performance-*,
  readability-container-size-empty,
  readability-redundant-*,
  readability-simplify-boolean-expr
WarningsAsErrors: ''
HeaderFilterRegex: '(include/proj|src|tests)/'
ExcludeHeaderFilterRegex: 'third_party/'
CheckOptions:
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'ftxui/.*;juce_.*;catch2/.*;nlohmann/.*'
