<!doctype html>
<!-- The GUI editor's window (src/apps/editor/web/main.js, tauri-editor.md
     §5.2) against a fake of Tauri: a sidecar that answers from a project in
     memory (§4.5), a folder dialog, and a window whose close can be held.
     CMake writes this page into the build tree, with the editor's import
     map made absolute. The result is written into #result, which
     --dump-dom prints; with ?shot=STATE the page stops in that state, for
     a screenshot, and files come from examples/phasing/. -->
<html lang="en">
<head>
<meta charset="utf-8">
<title>editor</title>
<link rel="stylesheet" href="@EDITOR_WEB@/editor.css">
<script type="importmap">
  {
    "imports": {
@EDITOR_IMPORT_MAP@
    }
  }
</script>
<script>
  localStorage.clear();
  const shot = new URLSearchParams(location.search).get("shot");
  const root = shot ? "/projects/phasing" : "/projects/drone";
  // A file of examples/phasing, read from disk for a screenshot.
  const example = (name) => {
    const request = new XMLHttpRequest();
    request.open("GET", "file://@EXAMPLES@/phasing/" + name, false);
    request.send();
    return request.responseText;
  };
  window.files = shot
    ? { "loops.lisp": example("loops.lisp"), "main.lisp": example("main.lisp"), "marimba.lisp": example("marimba.lisp") }
    : { "main.lisp": "(module main)\n(defpiece main () nil)\n", "lib/tone.lisp": "(module tone)\n",
        "latin1.lisp": null, "notes.txt": "notes\n" };
  window.requests = [];
  // The server the fake link reaches: up or not, and its status.
  window.serverUp = true;
  window.serverStatus = { connected: true, server: "espresso-server 0.2.0", bpm: 120, beat: 34.5, beatsPerBar: 4,
    missed: 0, xruns: 0, drops: 0, overflows: 0, load: 0.3, threads: 2, threadLoads: [0.3, 0.45], plan: 2 };
  window.destroyed = false;
  window.closes = 0;   // the window's close(), as Quit asks for it
  window.dialogs = 0;  // folder dialogs opened
  window.dialogAnswer = undefined;
  // The editor's server (main.rs): each server_start, the answer the next one gets, and the events main.rs emits.
  window.serverStarts = [];
  window.serverAnswer = { state: "running" };
  window.tauriEvents = {};
  window.emitEvent = (name, payload) => tauriEvents[name]?.({ payload });
  window.spawned = false;
  // The page's window (Tauri's WebviewWindow) and the browser (the shell's open).
  window.webviews = [];
  window.focusedWindows = 0;
  window.browsed = [];
  window.trashed = [];   // what Move to Trash moved
  window.revealed = [];  // what the opener showed in the file manager  // what the folder dialog answers: the project, or null for Cancel
  window.closeHandler = null;

  // The sidecar: each request line is answered on a later turn of the loop.
  class FakeCommand {
    constructor() {
      this.handlers = {};
      this.stdout = { on: (event, fn) => { this.handlers.stdout = fn; } };
      this.stderr = { on: () => {} };
    }
    on(event, fn) { this.handlers[event] = fn; }
    async spawn() {
      window.spawned = true;
      return {
        write: async (line) => {
          const request = JSON.parse(line);
          requests.push(request);
          setTimeout(() => this.answer(request), 0);
        },
        kill: async () => {},
      };
    }
    send(message) { this.handlers.stdout(JSON.stringify({ jsonrpc: "2.0", ...message }) + "\n"); }
    console(kind, text, location) { this.send({ method: "console", params: { kind, text, ...(location ? { location } : {}) } }); }
    status(changes) {
      Object.assign(serverStatus, changes);
      this.send({ method: "status", params: { ...serverStatus } });
    }
    // The server stops answering (tauri-editor.md 4.6: a lost connection).
    lose() {
      serverUp = false;
      this.status({ connected: false });
      this.console("server", "server: connection to 127.0.0.1:57290 lost");
    }
    answer({ id, method, params }) {
      const fail = (code, message) => this.send({ id, error: { code, message } });
      if (method === "hello") {
        window.sidecar = this;
        this.send({ id, result: { client: "test", protocol: 1, metadata: "0.7.0", server: "127.0.0.1:57290" } });
        this.status({});
        return;
      }
      // Run requests (tauri-editor.md 4.5.1): their console lines, then the response.
      if (method === "run.play") {
        const errors = [];
        for (const [path, text] of Object.entries(params.sources ?? {})) {
          const at = text.indexOf("(bad)");
          if (at < 0) continue;
          const before = text.slice(0, at + 1).split("\n");
          const location = { path, line: before.length, column: before.at(-1).length + 1 };
          errors.push(location);
          this.console("error", `${path}:${location.line}:${location.column}: unknown name bad`, location);
        }
        if (errors.length === 0) {
          this.console("info", "compiled main.lisp: 3 nodes, 2 pipes");
          this.status({ plan: serverStatus.plan + 1 });
        }
        return this.send({ id, result: { errors: errors.length } });
      }
      if (method === "run.eval") {
        this.console("info", `eval ${params.file}:${params.line}:${params.column}: read ${params.text}`);
        return this.send({ id, result: { errors: 0 } });
      }
      if (method === "run.stop") {
        this.console("server", `server: stopping (fade ${params.fade * 1000}ms)`);
        this.status({ plan: 0 });
        return this.send({ id, result: { errors: 0 } });
      }
      if (method === "server.connect") {
        if (serverUp) this.status({ connected: true });
        else this.console("server", "server: not reachable at 127.0.0.1:57290; the editor connects when espresso-server starts");
        return this.send({ id, result: { errors: 0 } });
      }
      if (method === "project.open") {
        if (params.root !== root) return fail(-32602, "params.root is not a directory: " + params.root);
        return this.send({ id, result: { root, files: Object.keys(files).sort() } });
      }
      if (method === "file.read") {
        if (!(params.path in files)) return fail(-32002, "cannot open " + params.path);
        if (files[params.path] === null) return fail(-32002, params.path + " is not valid UTF-8");
        return this.send({ id, result: { text: files[params.path] } });
      }
      if (method === "language") {
        return this.send({ id, result: { builtins: ["map"], library: [],
          primitives: [{ name: "sine-osc", params: [{ name: "freq", dimension: "frequency", default: 440 }],
            inputs: [], outputs: [{ name: "out", required: false }] }] } });
      }
      if (method === "file.write") {
        files[params.path] = params.text;
        return this.send({ id, result: null });
      }
      if (method === "file.create") {
        if (params.path in files) return fail(-32002, `A file or folder named \u201c${params.path.split("/").pop()}\u201d already exists`);
        files[params.path] = "";
        return this.send({ id, result: null });
      }
      if (method === "file.rename") {
        if (params.to in files) return fail(-32002, "exists");
        files[params.to] = files[params.from];
        delete files[params.from];
        return this.send({ id, result: null });
      }
      fail(-32601, "no method " + method);
    }
  }
  // Tauri's menu API: each item as created, by its id; each bar set.
  window.menuItems = {};
  window.menuBars = [];
  const menuKind = (kind) => class {
    static async new(options) {
      const it = Object.assign(new this(), { kind, ...options });
      if (options.id) menuItems[options.id] = it;
      return it;
    }
    async setText(text) { this.text = text; }
    async setEnabled(enabled) { this.enabled = enabled; }
    async setChecked(checked) { this.checked = checked; }
    async setAccelerator(accelerator) { this.accelerator = accelerator; }
    async setAsAppMenu() { menuBars.push(this); }
    async setAsWindowMenu() { menuBars.push(this); }
    async setAsWindowsMenuForNSApp() {}
    async setAsHelpMenuForNSApp() {}
  };
  window.__TAURI__ = {
    menu: { Menu: menuKind("menu"), Submenu: menuKind("submenu"), MenuItem: menuKind("item"),
      CheckMenuItem: menuKind("check"), PredefinedMenuItem: menuKind("predefined") },
    opener: { revealItemInDir: async (path) => { revealed.push(path); } },
    shell: { Command: { sidecar: () => new FakeCommand() }, open: async (url) => { browsed.push(url); } },
    webviewWindow: {
      WebviewWindow: class {
        constructor(label, options) { webviews.push({ label, ...options }); }
        once() {}
        static async getByLabel(label) {
          return webviews.some((w) => w.label === label) ? { setFocus: async () => { focusedWindows += 1; } } : null;
        }
      },
    },
    core: {
      invoke: async (command, args) => {
        if (command === "launch_project") return window.launchProject ?? null;
        if (command === "file_trash") {
          trashed.push(args.path);
          delete files[args.path];
          return null;
        }
        if (command !== "server_start") throw new Error("no command " + command);
        serverStarts.push({ ...args, beforeSidecar: !spawned });
        return serverAnswer;
      },
    },
    event: { listen: async (name, fn) => { tauriEvents[name] = fn; return () => {}; } },
    dialog: { open: async () => { dialogs += 1; return dialogAnswer === undefined ? root : dialogAnswer; } },
    window: {
      getCurrentWindow: () => ({
        setTitle: async () => {},
        onCloseRequested: async (fn) => { window.closeHandler = fn; },
        destroy: async () => { window.destroyed = true; },
        close: async () => { closes += 1; },
      }),
    },
  };
</script>
</head>
<body>
<div id="app"></div>
<pre id="result" style="position: absolute; left: -10000px; width: 1px; overflow: hidden">editor: running</pre>
<script type="module">
  import "@EDITOR_WEB@/main.js";
  import { isolateHistory } from "@codemirror/commands";

  const app = window.espressoEditor;
  const result = document.getElementById("result");
  const failures = [];
  const check = (ok, what) => { if (!ok) failures.push(what); };
  const isMac = /Mac/.test(navigator.platform);
  // A wait that stops the test when it times out, so the verdict is written
  // within the page's time budget (lessons.md).
  const stopped = new Error("stopped");
  const until = (condition, what, ms = 3000) => new Promise((resolve, reject) => {
    const deadline = Date.now() + ms;
    const poll = () => {
      if (condition()) return resolve(true);
      if (Date.now() > deadline) {
        failures.push("timed out waiting for " + what);
        return reject(stopped);
      }
      setTimeout(poll, 10);
    };
    poll();
  });
  const text = (selector) => document.querySelector(selector)?.textContent ?? "";
  const press = (key) => window.dispatchEvent(new KeyboardEvent("keydown",
    { key, metaKey: isMac, ctrlKey: !isMac, bubbles: true, cancelable: true }));
  // A key without the command modifier, at the focused element, as the window's capture sees it.
  // CodeMirror reads Tab, Enter, and Escape by keyCode.
  const keyCodes = { Tab: 9, Enter: 13, Escape: 27 };
  const key = (k, { shift = false, mod = false } = {}) => (document.activeElement ?? document.body).dispatchEvent(
    new KeyboardEvent("keydown", { key: k, keyCode: keyCodes[k] ?? 0, shiftKey: shift, metaKey: mod && isMac,
      ctrlKey: mod && !isMac, bubbles: true, cancelable: true }));
  // The next turn of the event loop: what a key's handling defers to a frame has run, as between two key presses.
  const settle = () => new Promise((resolve) => setTimeout(resolve, 0));
  // A chord at the focused element, as a keyboard sends it: "C-x", "M-u", "Mod-s", "S-:", "F9", "u".
  const codeOf = (k) => (/^[a-z]$/i.test(k) ? "Key" + k.toUpperCase() : /^\d$/.test(k) ? "Digit" + k
    : { "/": "Slash", ".": "Period", ",": "Comma", "\\": "Backslash", ":": "Semicolon" }[k] ?? k);
  const chord = (spec) => {
    const parts = spec.split(/-(?!$)/);
    const k = parts.pop();
    const mod = parts.includes("Mod");
    (document.activeElement ?? document.body).dispatchEvent(new KeyboardEvent("keydown", {
      key: k, code: codeOf(k), ctrlKey: parts.includes("C") || parts.includes("Ctrl") || (mod && !isMac),
      metaKey: mod && isMac, altKey: parts.includes("M") || parts.includes("Alt"),
      shiftKey: parts.includes("S") || parts.includes("Shift"), bubbles: true, cancelable: true }));
  };
  const chords = (sequence) => sequence.split(" ").forEach(chord);
  const sent = (method) => requests.filter((r) => r.method === method);
  const menuRow = (label) => [...document.querySelectorAll(".menu .row")].find((r) => r.textContent.startsWith(label));
  const play = () => document.querySelector(".top .btn.primary");
  const stop = () => [...document.querySelectorAll(".top .btn")].find((b) => b.textContent === "Stop");
  const problemsItem = () => [...document.querySelectorAll(".status .item")].find((i) => / errors?, /.test(i.title));
  const statusItem = (part) => [...document.querySelectorAll(".status .item")].find((i) => i.textContent.includes(part));
  const row = (path) => [...document.querySelectorAll(".tree .row")].find((r) => r.title === path);
  const tab = (name) => [...document.querySelectorAll(".tab")].find((t) => t.textContent.startsWith(name));
  const button = (label) => [...document.querySelectorAll(".scrim button")].find((b) => b.textContent === label);
  const written = (path) => requests.filter((r) => r.method === "file.write" && r.params.path === path);

  async function test() {
    // No folder: the empty state offers Open Folder; the server's status arrives.
    await until(() => text(".status").includes("espresso-server · 45%"), "the status bar to show the server");
    check(text(".status").includes("120 BPM · 9.3"), "tempo and bar.beat: " + text(".status"));
    check(text(".status").includes("Plan 2"), "the plan in the status bar");
    check(text(".empty h1") === "No Folder Open", "the empty state without a folder");

    // Open Folder: the project's files, the entry tagged, the name in the title.
    [...document.querySelectorAll(".empty button")].find((b) => b.textContent === "Open Folder…").click();
    await until(() => row("main.lisp"), "the project's files");
    check(text(".side .title") === "drone", "the navigator's title is the project");
    check(row("main.lisp").querySelector(".tag")?.textContent === "entry", "main.lisp is tagged entry");
    check(document.querySelectorAll(".tree .row").length === 4, "every file is listed");
    check(text(".empty h1") === "No File Open", "the empty state without a file");
    check(document.title === "drone — espresso", "the title names the project: " + document.title);
    check(localStorage.getItem("espresso.project") === "/projects/drone", "the project is remembered");
    // The editor's server (editor-refactor.md §4h.2) started before the client, and again with the project's root.
    check(serverStarts.length === 2 && serverStarts[0].beforeSidecar && serverStarts[0].root === null &&
          serverStarts[1].root === "/projects/drone",
          "the server starts before the client, then with the project's root: " + JSON.stringify(serverStarts));

    // Open a file: a current tab, the text, the current row, the position.
    row("main.lisp").click();
    await until(() => tab("main.lisp"), "main.lisp's tab");
    check(tab("main.lisp").classList.contains("current"), "the opened tab is current");
    check(app.view.state.doc.toString() === files["main.lisp"], "the editor shows the file");
    check(row("main.lisp").classList.contains("current"), "the navigator marks the open file");
    check(text(".status").includes("Ln 1, Col 1"), "the cursor's position");
    check(document.title === "main.lisp — drone", "the title names the file: " + document.title);

    // An edit marks the tab unsaved; Mod+S writes it through the sidecar.
    app.view.dispatch({ changes: { from: 0, insert: ";; drone\n" }, selection: { anchor: 9 } });
    check(tab("main.lisp").classList.contains("unsaved"), "an edit marks the tab unsaved");
    check(tab("main.lisp").querySelector('[aria-label="Unsaved changes"]'), "an unsaved tab shows its dot");
    check(document.title.startsWith("● "), "the title marks unsaved changes");
    check(text(".status").includes("Ln 2, Col 1"), "the position follows the cursor");
    press("s");
    await until(() => !tab("main.lisp").classList.contains("unsaved"), "the save to finish");
    check(written("main.lisp").length === 1 && written("main.lisp")[0].params.text === ";; drone\n(module main)\n(defpiece main () nil)\n",
          "Mod+S writes the buffer");

    // A file that does not read reaches the console, and opens no tab.
    row("latin1.lisp").click();
    await until(() => text(".log").includes("latin1.lisp is not valid UTF-8"), "the read error in the console");
    check(!tab("latin1.lisp"), "a failed read opens no tab");

    // Closing an unsaved tab asks: Cancel keeps it; Discard closes it.
    row("lib/tone.lisp").click();
    await until(() => tab("tone.lisp")?.classList.contains("current"), "tone.lisp's tab");
    app.view.dispatch({ changes: { from: 0, insert: "x" } });
    tab("tone.lisp").querySelector(".close").click();
    await until(() => document.querySelector(".scrim"), "the Save Changes alert");
    check(text(".dialog h2") === "Save Changes?", "the alert asks to save");
    check(document.activeElement === button("Save"), "Save is the default response");
    button("Cancel").click();
    check(tab("tone.lisp"), "Cancel keeps the tab");
    press("w");
    await until(() => document.querySelector(".scrim"), "the alert again, from Mod+W");
    button("Discard").click();
    await until(() => !tab("tone.lisp"), "Discard to close the tab");
    check(tab("main.lisp").classList.contains("current"), "the left-hand tab becomes current");
    check(written("lib/tone.lisp").length === 0, "Discard writes nothing");

    // F9 and Ctrl+F9 hide and show the side bar and the panel (GNOME's side pane, Builder's bottom panel);
    // the layout is remembered.
    key("F9");
    check(document.querySelector(".side").hidden, "F9 hides the side bar");
    chord("Mod-F9");
    check(document.querySelector(".panel").hidden, "Ctrl+F9 hides the panel");
    check(JSON.parse(localStorage.getItem("espresso.layout")).side === false, "the layout is remembered");
    key("F9");
    chord("Mod-F9");
    check(!document.querySelector(".side").hidden && !document.querySelector(".panel").hidden, "both come back");

    await running();
    await pages();
    await folding();
    await completing();
    await editingCommands();
    await keyRules();
    await menus();
    await fileOperations();
    await lineMarks();
    await ownServer();
    await keySchemes();
    await keyboard();
    contrast();
    names();

    // The window's close holds while changes are unsaved, and Save writes them first.
    const writesBeforeClose = written("main.lisp").length;
    app.view.dispatch({ changes: { from: 0, insert: ";" } });
    let prevented = false;
    const closing = window.closeHandler({ preventDefault: () => { prevented = true; } });
    await until(() => document.querySelector(".scrim"), "the alert on closing the window");
    check(prevented, "the close is held");
    button("Save").click();
    await until(() => window.destroyed, "the window to close after saving");
    check(written("main.lisp").length === writesBeforeClose + 1, "the window's close saves first");
    await closing;
  }

  // Play, Update, Stop, Problems, evaluation, the options, the server menu, and the banner (step 5).
  async function running() {
    // A plan plays (plan 2): Play reads Update, and Stop is enabled.
    check(text(".top .btn.primary") === "Update", "Play reads Update while a plan plays: " + text(".top .btn.primary"));
    check(!stop().disabled, "Stop is enabled while a plan plays");
    check(problemsItem()?.title.startsWith("0 errors"), "the status bar counts no problems");

    // Play (Shift+Ctrl+Space) sends the unsaved buffer; its error is a console link, a problem, and a squiggle.
    app.view.dispatch({ changes: { from: app.view.state.doc.length, insert: "(bad)\n" } });
    chord("Mod-Shift-Space");
    await until(() => text(".panel .badge") === "1", "the error's problem");
    const played = sent("run.play").at(-1);
    check(played.params.sources["main.lisp"].includes("(bad)"), "Play sends the unsaved buffer");
    check(played.params.file === "main.lisp" && played.params.fade === 0.05 && played.params.quantize === "none",
          "Play sends the file, the fade, and the quantize: " + JSON.stringify(played.params));
    const link = document.querySelector(".log a");
    check(link?.textContent === "main.lisp:4:2", "the error's place is a link: " + link?.textContent);
    check(document.querySelector(".cm-lintRange-error")?.textContent === "bad", "the error's token is underlined");
    check(document.querySelector(".cm-lint-marker-error"), "the error's line is marked in the glyph margin");
    check(problemsItem()?.title.startsWith("1 error,"), "the status bar counts the problem");
    problemsItem().click();
    check(!document.querySelector('.panel [aria-label="Problems"]').hidden, "the count shows Problems");
    check(text(".problem").includes("unknown name bad") && text(".problem").includes("main.lisp:4:2"), "the problem's row");
    app.view.dispatch({ selection: { anchor: 0 } });
    document.querySelector(".problem").click();
    const bad = app.view.state.doc.toString().indexOf("bad");
    await until(() => app.view.state.selection.main.head === bad, "the problem's row to move the cursor");
    document.querySelector('.view[data-view="console"]').click();
    app.view.dispatch({ selection: { anchor: 0 } });
    document.querySelector(".log a").click();
    await until(() => app.view.state.selection.main.head === bad, "the console's link to move the cursor");

    // The fix plays cleanly: the problems go, and the plan is updated.
    const fixed = app.view.state.doc.toString().indexOf("(bad)");
    app.view.dispatch({ changes: { from: fixed, to: fixed + 6 } });
    chord("Mod-Shift-Space");
    await until(() => serverStatus.plan === 3 && document.querySelector(".panel .badge").hidden, "the clean play");
    check(!document.querySelector(".cm-lintRange-error"), "no problems, no squiggle");

    // Mod+Enter evaluates the top-level form at the cursor and marks it; Shift+Enter the form before it.
    const doc = app.view.state.doc.toString();
    app.view.focus();
    app.view.dispatch({ selection: { anchor: doc.indexOf("main () nil") } });
    key("Enter", { mod: true });
    check(document.querySelector(".cm-evaluated"), "the evaluated form is marked");
    await until(() => sent("run.eval").length === 1, "the evaluation");
    const form = sent("run.eval")[0].params;
    check(form.text === "(defpiece main () nil)" && form.line === 3 && form.column === 1 && form.file === "main.lisp",
          "Mod+Enter evaluates the form at the cursor: " + JSON.stringify(form));
    await until(() => !document.querySelector(".cm-evaluated"), "the mark to clear");
    app.view.dispatch({ selection: { anchor: doc.indexOf("(module main)") + "(module main)".length } });
    key("Enter", { shift: true });
    await until(() => sent("run.eval").length === 2, "the second evaluation");
    check(sent("run.eval")[1].params.text === "(module main)", "Shift+Enter evaluates the form before the cursor");
    check(app.view.state.doc.toString() === doc, "the evaluate keys insert nothing");

    // The options: a crossfade and a grid, remembered, sent with the next run.
    document.querySelector('.top [aria-label="Play options"]').click();
    check(menuRow("50 ms")?.getAttribute("aria-checked") === "true", "the crossfade's default is checked");
    menuRow("250 ms").click();
    document.querySelector('.top [aria-label="Play options"]').click();
    menuRow("Bar").click();
    check(JSON.parse(localStorage.getItem("espresso.run")).fade === 0.25, "the options are remembered");
    play().click();
    await until(() => serverStatus.plan === 4, "the play with options");
    check(sent("run.play").at(-1).params.fade === 0.25 && sent("run.play").at(-1).params.quantize === "bar",
          "Play sends the chosen options");

    // Stop: the plan stops with the crossfade; Play reads Play, and Stop is disabled.
    stop().click();
    await until(() => text(".top .btn.primary") === "Play", "Play after Stop");
    check(sent("run.stop").at(-1).params.fade === 0.25, "Stop fades with the crossfade");
    check(stop().disabled, "Stop is disabled with no plan");
    check(statusItem("No Plan"), "the status bar shows no plan");

    // The server's menu lists its counters.
    statusItem("espresso-server").click();
    check(menuRow("Missed deadlines") && text(".menu .head").includes("127.0.0.1:57290"), "the server menu: " + text(".menu"));
    key("Escape");
    check(!document.querySelector(".menu"), "Escape closes the server menu");

    // The filter narrows the console.
    const filter = document.querySelector(".panel .filter");
    filter.value = "eval main";
    filter.dispatchEvent(new Event("input"));
    check(document.querySelectorAll(".log .msg").length === 2, "the filter shows the matching lines");
    filter.value = "";
    filter.dispatchEvent(new Event("input"));

    // Maximize takes the editor's row, and restores it.
    document.querySelector('.panel [aria-label="Maximize panel"]').click();
    check(document.querySelector(".content").classList.contains("max-panel"), "the panel maximizes");
    document.querySelector('.panel [aria-label="Restore panel"]').click();
    check(!document.querySelector(".content").classList.contains("max-panel"), "the panel restores");

    // A lost server: the banner says so, with Retry; the run buttons are disabled until it answers.
    sidecar.lose();
    await until(() => !document.querySelector(".banner").hidden, "the banner");
    check(text(".banner").includes("No reply from espresso-server at 127.0.0.1:57290"), "the banner: " + text(".banner"));
    check(play().disabled && stop().disabled, "no server, no Play or Stop");
    check(statusItem("No reply"), "the status bar shows no reply");
    document.querySelector(".banner button").click();
    await until(() => text(".log").includes("not reachable"), "Retry without a server");
    check(!document.querySelector(".banner").hidden, "the banner stays while the server is absent");
    serverUp = true;
    document.querySelector(".banner button").click();
    await until(() => document.querySelector(".banner").hidden, "the banner to go once the server answers");
    check(!play().disabled, "Play comes back with the server");

    // Update on Save: a save updates the plan that plays.
    play().click();
    await until(() => serverStatus.plan === 1, "a plan to play");  // Stop ended plan 4
    document.querySelector('.top [aria-label="Play options"]').click();
    menuRow("Update on Save").click();
    app.view.dispatch({ changes: { from: 0, insert: ";" } });
    press("s");
    await until(() => serverStatus.plan === 2, "the save to update the plan");
    check(sent("run.play").at(-1).params.sources["main.lisp"].startsWith(";"), "the update plays the saved text");
  }

  // The sketches' states (brand/gui/b.py, STATES): loops.lisp at line 84,
  // the console's lines, and the error at 82:44 as Problems shows it.
  // The piece's page (patterns.md §18): a tab that opens by itself when a plan with a page plays.
  async function pages() {
    const pageTab = () => document.querySelector(".tab.page-tab");
    const frame = () => document.querySelector(".page .frame");
    const pageShown = () => !document.querySelector(".page").hidden;
    check(!pageTab(), "no page tab while no plan has a page");

    sidecar.status({ plan: 7, page: 8000 });
    await until(() => pageTab(), "the page's tab to open by itself");
    check(pageTab().classList.contains("current") && pageShown(), "the page's tab is shown");
    check(text(".tab.page-tab") === "Page · drone", "the tab names the project: " + text(".tab.page-tab"));
    check(frame().getAttribute("src") === "http://127.0.0.1:8000/" && !frame().hidden, "the frame shows the page");
    check(frame().getAttribute("sandbox") === "allow-scripts allow-same-origin allow-forms", "the frame is sandboxed");
    check(text(".page .address") === "http://127.0.0.1:8000/", "the bar names the address");

    // A file's tab shows the file; the page's tab shows the page again.
    tab("main.lisp").click();
    check(!pageShown() && !app.view.dom.hidden && !pageTab().classList.contains("current"), "a file's tab leaves the page");
    pageTab().click();
    check(pageShown() && app.view.dom.hidden, "the page's tab shows it again");
    // A file opened from the navigator shows in place of the page, even the file already current.
    row("main.lisp").click();
    await until(() => !pageShown() && !app.view.dom.hidden, "the navigator's file in place of the page");
    pageTab().click();

    // No page plays: the empty state, and the bar's buttons wait.
    sidecar.status({ plan: 0, page: null });
    await until(() => !document.querySelector(".page-empty").hidden, "the page's empty state");
    check(text(".page-empty h1") === "No Page Playing" && frame().hidden && !frame().hasAttribute("src"), "no frame without a page");
    check([...document.querySelectorAll(".page .bar button")].every((b) => b.disabled), "the bar's buttons wait for a page");
    sidecar.status({ plan: 8, page: 8000 });
    await until(() => frame().getAttribute("src") === "http://127.0.0.1:8000/", "the page to come back");

    // Open in Window, then the same window forward; Open in Browser.
    document.querySelector('.page [aria-label="Open in window"]').click();
    await until(() => webviews.length === 1, "the page's window");
    check(webviews[0].label === "page" && webviews[0].url === "http://127.0.0.1:8000/", "the window loads the page");
    document.querySelector('.page [aria-label="Open in window"]').click();
    await until(() => focusedWindows === 1, "the same window to come forward");
    check(webviews.length === 1, "a second Open in Window makes no second window");
    document.querySelector('.page [aria-label="Open in browser"]').click();
    await until(() => browsed[0] === "http://127.0.0.1:8000/", "the browser to open the page");

    // Mod+W closes the page's tab; it does not open by itself again in this project, and Show Page opens it.
    pageTab().focus();
    press("w");
    check(!pageTab() && !app.view.dom.hidden, "Mod+W closes the page's tab");
    sidecar.status({ plan: 0, page: null });
    sidecar.status({ plan: 9, page: 8000 });
    await settle();
    check(!pageTab(), "a closed page's tab stays closed");
    app.runCommand("showPage");
    check(pageTab()?.classList.contains("current"), "Show Page opens it");

    // The page's tab pulled out of the strip opens the page in a window of its own, where it is dropped.
    webviews.length = 0;
    const pointer = (type, target, x, y) => target.dispatchEvent(new PointerEvent(type, {
      pointerId: 1, button: 0, clientX: x, clientY: y, screenX: x + 1000, screenY: y + 500, bubbles: true, cancelable: true }));
    const box = pageTab().getBoundingClientRect();
    const [x, y] = [box.x + 20, box.y + box.height / 2];
    // A short drag along the strip leaves the tab where it is.
    pointer("pointerdown", pageTab(), x, y);
    pointer("pointermove", window, x + 30, y);
    check(document.querySelector(".tab-ghost") && !document.querySelector(".tab-ghost.tearing"), "a drag along the strip");
    pointer("pointerup", window, x + 30, y);
    pageTab().click();
    check(!document.querySelector(".tab-ghost") && pageTab() && webviews.length === 0, "it opens no window");
    // Beyond the strip, the ghost is the window's outline; the drop opens the window there and takes the tab away.
    pointer("pointerdown", pageTab(), x, y);
    pointer("pointermove", window, x + 200, y + 300);
    check(document.querySelector(".tab-ghost.tearing"), "beyond the strip, the outline of a window");
    pointer("pointerup", window, x + 200, y + 300);
    await until(() => webviews.length === 1, "the torn-off page's window");
    check(webviews[0].url === "http://127.0.0.1:8000/" && webviews[0].x === x + 1160 && webviews[0].y === y + 786,
          "the window opens where the tab was dropped: " + JSON.stringify(webviews[0]));
    check(!pageTab() && !document.querySelector(".tab-ghost"), "the tab leaves the main window");
    app.runCommand("showPage");
    pageTab().click();
    check(pageTab().classList.contains("current"), "a plain click still shows the page");
    app.closePage();
    sidecar.status({ plan: 2, page: null });
  }

  // Folding (patterns.md §5): a list over several lines folds from its fold margin, its keys, and the commands.
  async function folding() {
    const original = app.view.state.doc.toString();
    app.view.focus();
    app.view.dispatch({ changes: { from: 0, to: original.length,
      insert: "(define (tone f)\n  (sine-osc :freq f\n            :out out))\n(play\n  (tone 440hz))\n" } });
    await settle();
    const markers = () => [...document.querySelectorAll(".cm-foldMargin .cm-foldMarker")];
    check(markers().length === 3, "a chevron on each line where a list folds: " + markers().length);
    const placeholder = () => document.querySelector(".cm-foldPlaceholder");
    // A click on the first chevron folds the define; another unfolds it.
    const click = (marker) => {
      const box = marker.getBoundingClientRect();
      marker.dispatchEvent(new MouseEvent("click", { bubbles: true, clientX: box.x + 4, clientY: box.y + box.height / 2 }));
    };
    click(markers()[0]);
    await settle();
    check(placeholder() && app.view.dom.querySelectorAll(".cm-line").length === 4, "the click folds the define's lines");
    check(document.querySelector(".cm-foldMarker.folded"), "a folded line keeps its chevron");
    click(document.querySelector(".cm-foldMarker.folded"));
    await settle();
    check(!placeholder() && app.view.dom.querySelectorAll(".cm-line").length === 6, "a second click unfolds it");
    // The keys and the commands.
    app.view.dispatch({ selection: { anchor: app.view.state.doc.line(4).from } });
    chord("Mod-Alt-[");
    check(placeholder(), "Mod+Alt+[ folds the list at the cursor");
    chord("Mod-Alt-]");
    check(!placeholder(), "Mod+Alt+] unfolds it");
    app.runCommand("foldAll");
    check(document.querySelectorAll(".cm-foldPlaceholder").length === 2, "Fold All folds the top-level forms");
    app.runCommand("unfoldAll");
    check(!placeholder(), "Unfold All unfolds them");
    app.view.dispatch({ changes: { from: 0, to: app.view.state.doc.length, insert: original } });
  }

  // Completion (complete.js): typing opens the list, in Carbon; Enter takes the selected suggestion.
  async function completing() {
    check(sent("language").length === 1, "the editor asks the sidecar for the language once");
    const original = app.view.state.doc.toString();
    app.view.focus();
    const end = original.length;
    app.view.dispatch({ changes: { from: end, insert: "(sine-osc :fr" }, selection: { anchor: end + 13 },
      userEvent: "input.type" });
    await until(() => document.querySelector(".cm-tooltip-autocomplete li"), "the completion list");
    check(text(".cm-tooltip-autocomplete li[aria-selected]").startsWith(":freq"), "the primitive's keyword is offered: "
      + text(".cm-tooltip-autocomplete"));
    await new Promise((resolve) => setTimeout(resolve, 120));  // the list takes keys 75 ms after it opens, as a person would
    key("Enter");
    check(app.view.state.doc.toString().endsWith("(sine-osc :freq"), "Enter takes it: " + JSON.stringify(app.view.state.doc.toString().slice(-20)));
    app.view.dispatch({ changes: { from: 0, to: app.view.state.doc.length, insert: original } });
    await settle();
  }

  // The editing commands (patterns.md §22, §25), each by its CUA key, in the code.
  async function editingCommands() {
    const original = app.view.state.doc.toString();
    const T = "(define (tone f)\n  (sine-osc :freq f :out out))\n(play (tone 440hz))\n";
    const doc = () => app.view.state.doc.toString();
    const line = (n) => app.view.state.doc.line(n).text;
    const sel = () => app.view.state.selection;
    const selected = () => sel().ranges.map((r) => app.view.state.sliceDoc(r.from, r.to));
    const reset = (at = 0) => {
      app.view.dispatch({ changes: { from: 0, to: app.view.state.doc.length, insert: T }, selection: { anchor: at } });
      app.view.focus();
    };
    const undone = (what) => {
      chord("Mod-z");
      check(doc() === T, `Mod+Z undoes ${what}: ` + JSON.stringify(doc()));
    };
    reset();

    chord("Mod-u");
    check(line(2) === line(1), "Mod+U duplicates the line (the HIG's Duplicate)");
    undone("the duplicate");
    chord("Mod-Shift-z");
    check(line(2) === line(1), "Mod+Shift+Z redoes it");
    undone("it again");
    chord("Alt-ArrowDown");
    check(line(2) === "(define (tone f)", "Alt+Down moves the line down");
    undone("the move");
    app.view.dispatch({ selection: { anchor: app.view.state.doc.line(3).from } });
    chord("Mod-Shift-Delete");
    check(app.view.state.doc.lines === 3 && !doc().includes("(play"), "Mod+Shift+Delete deletes the line");
    undone("the delete");
    reset();
    chord("Mod-/");
    check(line(1).startsWith(";"), "Mod+/ comments the line: " + line(1));
    undone("the comment");
    app.view.dispatch({ selection: { anchor: 0, head: 16 } });
    chord("Mod-Alt-/");
    check(line(1).startsWith("#|"), "Mod+Alt+/ comments the selection as a block: " + line(1));
    undone("the block comment");
    reset();
    chord("Mod-j");
    check(line(1) === "(define (tone f) (sine-osc :freq f :out out))", "Mod+J joins the lines: " + line(1));
    undone("the join");
    chord("Mod-a");
    chord("Mod-Shift-j");
    check(line(1) === "  (sine-osc :freq f :out out))" && line(3) === "(play (tone 440hz))", "Mod+Shift+J sorts the lines");
    undone("the sort");

    // Selection by form: a name, the list's contents, the list; and back.
    const tone = T.lastIndexOf("tone");
    reset(tone + 1);
    const expand = isMac ? "Ctrl-Shift-ArrowRight" : "Shift-Alt-ArrowRight";
    const shrink = isMac ? "Ctrl-Shift-ArrowLeft" : "Shift-Alt-ArrowLeft";
    chord(expand);
    check(selected()[0] === "tone", "Expand Selection takes the name: " + selected());
    chord(expand);
    check(selected()[0] === "tone 440hz", "then the list's contents: " + selected());
    chord(expand);
    check(selected()[0] === "(tone 440hz)", "then the list: " + selected());
    chord(shrink);
    chord(shrink);
    check(selected()[0] === "tone", "Shrink Selection goes back the way it came: " + selected());
    chord(shrink);
    check(sel().main.empty && sel().main.head === tone + 1, "to the cursor");

    // Several cursors: the next occurrence, all of them, the line below; Deselect All.
    app.view.dispatch({ selection: { anchor: tone, head: tone + 4 } });
    chord("Mod-e");
    check(sel().ranges.length === 2 && selected().every((t) => t === "tone"), "Mod+E adds the next occurrence");
    chord("Mod-Shift-a");
    check(sel().ranges.length === 1 && sel().main.empty, "Mod+Shift+A deselects (the HIG's Deselect All)");
    app.view.dispatch({ selection: { anchor: tone, head: tone + 4 } });
    chord("Mod-Shift-l");
    check(sel().ranges.length === 2, "Mod+Shift+L selects every occurrence");
    reset();
    chord("Mod-Alt-ArrowDown");
    check(sel().ranges.length === 2, "Mod+Alt+Down adds a cursor below");
    chord("Mod-Shift-a");
    check(sel().ranges.length === 1, "Deselect All keeps one cursor");
    app.view.dispatch({ selection: { anchor: 0 } });
    chord("Mod-Shift-\\");
    check(sel().main.head === T.indexOf("\n(play"), "Mod+Shift+\\ goes to the matching bracket: " + sel().main.head);
    app.view.dispatch({ selection: { anchor: tone, head: tone + 4 } });
    app.runCommand("upperCase");
    check(doc().includes("(TONE 440hz)"), "Upper Case");
    app.runCommand("titleCase");
    check(doc().includes("(Tone 440hz)"), "Title Case");
    app.runCommand("lowerCase");
    check(doc() === T, "Lower Case");
    check(JSON.stringify(app.view.state.languageDataAt("closeBrackets", 1)[0]?.brackets) === '["(","[","\\""]',
          "brackets and strings close as they open, a quote does not");

    // Go to Definition, then Back and Forward.
    reset(tone + 1);
    key("F12");
    await until(() => sel().main.head === T.indexOf("tone"), "F12 goes to the definition");
    chord(isMac ? "Ctrl--" : "Alt-ArrowLeft");
    await until(() => sel().main.head === tone + 1, "Back returns to the call");
    chord(isMac ? "Ctrl-Shift--" : "Alt-ArrowRight");
    await until(() => sel().main.head === T.indexOf("tone"), "Forward to the definition again");

    // An editing command's key is the code's alone: in a field it does the field's work.
    reset(3);
    chord("Mod-k");
    const field = document.querySelector(".picker .field");
    field.value = "abc";
    chord("Mod-a");
    check(sel().main.empty && sel().main.head === 3, "Mod+A in the picker's field leaves the code's selection");
    key("Escape");
    app.view.dispatch({ changes: { from: 0, to: app.view.state.doc.length, insert: original } });
    await settle();
  }

  // The native menu bar (patterns.md §19.8): built once from the command table and kept current; its
  // model keeps GNOME's rules for menus on Linux and the Apple HIG's app and Window menus on macOS.
  async function menus() {
    const { commandTable } = await import("@EDITOR_WEB@/commands.js");
    const { bindingOf } = await import("@EDITOR_WEB@/schemes.js");
    const { acceleratorOf } = await import("@EDITOR_WEB@/menubar.js");
    const commands = new Set(commandTable.map((c) => c.name));
    for (const mac of [false, true]) {
      const platform = mac ? "macOS" : "Linux";
      const model = app.menuModel(mac);
      const accelerators = new Map();
      const keyOf = (label) => /&(.)/.exec(label)?.[1].toLowerCase();
      const items = (entries, depth) => {
        const counted = entries.filter((e) => e.kind !== "separator");
        const keys = new Set();
        for (const e of entries) {
          if (e.kind === "submenu") {
            check(depth === 0, `${platform}: ${e.label} is a nested submenu`);
            check(e.items.length >= 3 && e.items.length <= 6, `${platform}: ${e.label} holds ${e.items.length} items, not 3 to 6`);
            items(e.items, depth + 1);
          }
          if (e.kind === "predefined") check(mac && e.item !== "Separator", `${platform}: a system item ${e.item}`);
          if (e.kind !== "command" && e.kind !== "submenu") continue;
          if (!mac) {
            const k = keyOf(e.label);
            check(k && (e.label.match(/&/g) ?? []).length === 1, `${platform}: ${e.label} has no access key`);
            check(!keys.has(k), `${platform}: ${e.label} repeats the access key ${k}`);
            keys.add(k);
          } else {
            check(!e.label.includes("&"), `${platform}: ${e.label} shows an access key`);
          }
          if (e.kind !== "command") continue;
          check(commands.has(e.name) && app.commandNames().has(e.name), `${platform}: ${e.name} is not a command`);
          const expected = !mac && ["cut", "copy", "paste"].includes(e.name) ? null
            : acceleratorOf(bindingOf(app.scheme, e.name));
          check(e.accelerator === expected, `${platform}: ${e.name}'s accelerator ${e.accelerator}, not ${expected}`);
          if (e.accelerator) {
            check(!accelerators.has(e.accelerator), `${platform}: ${e.accelerator} on ${e.name} and ${accelerators.get(e.accelerator)}`);
            accelerators.set(e.accelerator, e.name);
          }
        }
        return counted.length;
      };
      for (const menu of model) {
        const n = items(menu.items, 0);
        // Help reaches the HIG's three in step E, with the guides (editor-refactor.md §4i.2).
        check(n >= (menu.help ? 1 : 3) && n <= 12, `${platform}: ${menu.label} holds ${n} items, not 3 to 12`);
      }
      const labels = model.map((m) => m.label.replace("&", "")).join(",");
      check(labels === (mac ? "espresso,File,Edit,Selection,View,Go,Play,Window,Help" : "File,Edit,Selection,View,Go,Play,Help"),
            `${platform}: the menus ${labels}`);
      const names = (menu) => model.find((m) => m.label.replace("&", "") === menu).items.map((i) => i.name ?? i.item);
      if (mac) {
        check(names("espresso").includes("showAbout") && names("espresso").includes("quit") && !names("File").includes("quit"),
              "macOS: About and Quit are the app menu's");
        check(names("Edit").slice(0, 2).join() === "Undo,Redo", "macOS: Edit begins with the system's Undo and Redo");
      } else {
        check(names("File").at(-1) === "quit" && names("Help").at(-1) === "showAbout", "Linux: Quit ends File, About ends Help");
      }
    }

    // The bar Tauri builds, its items running their commands and following the window.
    await until(() => menuBars.length === 1, "the menu bar");
    check(menuItems.save && menuItems.toggleFileList.kind === "check", "the bar holds the commands, a toggle as a check item");
    check(menuItems.toggleFileList.checked === true, "Side Bar starts checked");
    menuItems.toggleFileList.action();
    check(document.querySelector(".side").hidden, "a menu item runs its command");
    await until(() => menuItems.toggleFileList.checked === false, "the check follows the side bar");
    menuItems.toggleFileList.action();
    check(menuBars.length === 1, "the bar is built once");
    check(!document.querySelector('.top [aria-label="Main menu"]'), "the drawn main menu is gone");
  }

  // Context menus and the tree's file operations (patterns.md §20.7, §23.5).
  async function fileOperations() {
    const contextAt = (el) => {
      const r = el.getBoundingClientRect();
      const e = new MouseEvent("contextmenu", { bubbles: true, cancelable: true, button: 2,
        clientX: r.left + 10, clientY: r.top + Math.min(r.height / 2, 8) });
      el.dispatchEvent(e);
      return e;
    };
    const labels = () => [...document.querySelectorAll(".menu .row")].map((r) => r.querySelector(".grow").textContent);
    const popover = () => document.querySelector(".popover");
    const pick = (label) => {
      const r = menuRow(label);
      if (!r) {
        failures.push(`no menu row ${label} in ${labels()}`);
        throw stopped;
      }
      r.click();
    };
    const enter = (value) => {
      const field = popover().querySelector(".field");
      field.value = value;
      field.dispatchEvent(new Event("input", { bubbles: true }));
      field.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", keyCode: 13, bubbles: true, cancelable: true }));
    };

    // The code's menu, by the secondary click and by Shift+F10.
    app.view.focus();
    contextAt(app.view.contentDOM);
    check(labels().join(",") === "Cut,Copy,Paste,Undo,Redo,Select All,Toggle Comment,Evaluate Form,Evaluate Last Form,"
          + "Go to Definition,Toggle Mark,Show All Commands…", "the code's context menu: " + labels());
    key("Escape");
    check(!document.querySelector(".menu"), "Escape closes it");
    app.view.focus();
    key("F10", { shift: true });
    check(document.querySelector(".menu")?.getAttribute("aria-label") === "Code", "Shift+F10 opens it from the keyboard");
    key("Escape");
    check(contextAt(document.querySelector(".status")).defaultPrevented && !document.querySelector(".menu"),
          "elsewhere the webview's own menu does not open, and nothing does");

    // A file's menu: New File… in its folder, with GNOME Builder's popover.
    contextAt(row("lib/tone.lisp"));
    check(labels().join(",") === "Open,New File…,Copy Path,Copy Relative Path,Open Containing Folder,Rename…,Move to Trash",
          "a file's context menu: " + labels());
    pick("New File…");
    check(popover()?.querySelector(".field").value === "lib/", "New File… asks for a name in the file's folder");
    enter("lib/tone.lisp");
    await until(() => popover()?.querySelector(".error").textContent.includes("already exists"), "the name's error");
    check(popover(), "a name that exists leaves the popover open, its error inline");
    enter("lib/bass.lisp");
    await until(() => tab("bass.lisp") && row("lib/bass.lisp"), "the new file, open");
    check(!popover() && sent("file.create").at(-1).params.path === "lib/bass.lisp", "the file is created and opened");

    // Rename… selects the name without its extension; the open tab follows the file.
    contextAt(row("lib/bass.lisp"));
    pick("Rename…");
    const field = popover().querySelector(".field");
    check(field.value.slice(field.selectionStart, field.selectionEnd) === "bass", "Rename selects the name: "
          + field.value.slice(field.selectionStart, field.selectionEnd));
    enter("lib/lead.lisp");
    await until(() => tab("lead.lisp") && row("lib/lead.lisp") && !row("lib/bass.lisp"), "the renamed file");

    // Move to Trash: at once to the eye, with Undo; the move itself when the toast goes.
    contextAt(row("lib/lead.lisp"));
    pick("Move to Trash");
    await until(() => !row("lib/lead.lisp") && document.querySelector(".toast"), "the toast");
    check(text(".toast").startsWith("“lead.lisp” moved to trash") && !tab("lead.lisp"), "the file leaves the tree and its tab");
    [...document.querySelectorAll(".toast button")].find((b) => b.textContent === "Undo").click();
    await until(() => row("lib/lead.lisp") && !document.querySelector(".toast"), "Undo");
    check(trashed.length === 0, "Undo moves nothing");
    row("lib/lead.lisp").focus();
    key("Delete");
    await until(() => !row("lib/lead.lisp"), "Delete in the tree");
    contextAt(row("notes.txt"));
    pick("Move to Trash");
    await until(() => trashed.includes("lib/lead.lisp") && text(".toast").includes("notes.txt"),
      "the first move, as a second toast takes its place");
    [...document.querySelectorAll(".toast button")].find((b) => b.textContent === "Undo").click();
    await until(() => row("notes.txt"), "the second one undone");
    check(trashed.join() === "lib/lead.lisp", "only the first was moved: " + trashed);

    // A tab's menu ends with Close; Reveal in Side Bar focuses its row; the paths go to the clipboard's caller.
    contextAt(tab("main.lisp"));
    check(labels().join(",") === "Copy Path,Copy Relative Path,Reveal in Side Bar,Close Other Editors,"
          + "Close Saved Editors,Close All Editors,Close", "a tab's context menu: " + labels());
    pick("Reveal in Side Bar");
    check(document.activeElement === row("main.lisp"), "Reveal in Side Bar focuses the file's row");
    contextAt(row("main.lisp"));
    pick("Open Containing Folder");
    check(revealed.at(-1) === root + "/main.lisp", "Open Containing Folder shows the file in the file manager: " + revealed);
    key("Escape");
    app.view.focus();
  }

  // Line marks (patterns.md §21.7): Ctrl+D, Ctrl+B and Shift+Ctrl+B, the margin's click; they follow edits,
  // are kept per project, listed by Show Marks, and cleared with Undo.
  async function lineMarks() {
    const { markedLines, restoredMarks } = await import("@EDITOR_WEB@/marks.js");
    const { EditorState } = await import("@codemirror/state");
    const original = app.view.state.doc.toString();
    const at = () => app.view.state.doc.lineAt(app.view.state.selection.main.head).number;
    const marked = () => markedLines(app.view.state).join();
    const goLine = (n) => app.view.dispatch({ selection: { anchor: app.view.state.doc.line(n).from } });
    app.view.dispatch({ changes: { from: 0, to: original.length, insert: "(a)\n(b)\n(c)\n(d)\n(e)\n" } });
    app.view.focus();
    goLine(2);
    chord("Mod-d");
    check(marked() === "2", "Mod+D marks the cursor's line: " + marked());
    await settle();
    check(document.querySelector(".cm-marksMargin .cm-markMarker"), "the mark shows in the marks margin");
    chord("Mod-d");
    check(marked() === "", "Mod+D again clears it");
    chord("Mod-d");
    goLine(4);
    chord("Mod-d");
    goLine(1);
    chord("Mod-b");
    check(at() === 2, "Mod+B goes to the next mark");
    chord("Mod-b");
    chord("Mod-b");
    check(at() === 2, "and wraps round: " + at());
    chord("Mod-Shift-b");
    check(at() === 4, "Mod+Shift+B goes back, wrapping: " + at());

    // Edits: a line above moves the marks down; a marked line's deletion leaves its mark on the line in its place.
    app.view.dispatch({ changes: { from: 0, insert: "(top)\n" } });
    check(marked() === "3,5", "a line inserted above moves the marks: " + marked());
    const three = app.view.state.doc.line(3);
    app.view.dispatch({ changes: { from: three.from, to: three.to + 1 } });
    check(marked() === "3,4", "a deleted marked line's mark stays on the line in its place: " + marked());

    // The margin's click; the marks kept for the project, with each line's text.
    await settle();
    const lineTop = app.view.lineBlockAt(0).top + app.view.documentTop;
    const cell = [...document.querySelectorAll(".cm-marksMargin .cm-gutterElement")]
      .find((e) => Math.abs(e.getBoundingClientRect().top - lineTop) < 1);
    cell.dispatchEvent(new MouseEvent("mousedown", { bubbles: true, cancelable: true, button: 0,
      clientX: cell.getBoundingClientRect().left + 4, clientY: lineTop + 4 }));
    check(marked() === "1,3,4", "a click in the margin marks its line: " + marked());
    const kept = JSON.parse(localStorage.getItem("espresso.marks"))[root][app.workspace.current.path];
    check(kept?.map((m) => `${m.line}:${m.text}`).join() === "1:(top),3:(c),4:(d)", "kept as lines and texts: " + JSON.stringify(kept));
    const moved = EditorState.create({ doc: "x\n(top)\n(d)\ny\n" }).doc;  // (c) is on no line
    check(restoredMarks(moved, kept).map((p) => moved.lineAt(p).number).join() === "2,3",
          "restored at their texts' nearest lines, and dropped where no line has the text");

    // Show Marks lists them; Enter goes to one.
    chord("Mod-Alt-d");
    const rows = () => [...document.querySelectorAll(".picker .row")];
    check(rows().length === 3 && rows()[1].textContent.includes("(c)"), "Mod+Alt+D lists the marks: " + rows().map((r) => r.textContent));
    goLine(1);
    rows()[2].click();
    await until(() => at() === 4, "a mark from the list");

    // Clear Marks, then Undo.
    app.runCommand("clearMarks");
    await until(() => marked() === "" && text(".toast").startsWith("Marks cleared"), "Clear Marks, with a toast");
    [...document.querySelectorAll(".toast button")].find((b) => b.textContent === "Undo").click();
    check(marked() === "1,3,4", "Undo brings them back: " + marked());
    app.view.dispatch({ changes: { from: 0, to: app.view.state.doc.length, insert: original } });
    app.view.dispatch({ effects: (await import("@EDITOR_WEB@/marks.js")).setMarks.of([]) });
    await settle();
  }

  // The CUA scheme's keys keep GNOME's standard keys for GNOME's commands, and none is Alt with a letter
  // (patterns.md §25; developer.gnome.org/hig/reference/keyboard.html). The HIG's formatting keys
  // (Bold Ctrl+B, Italic Ctrl+I) are a code editor's to use, as GNOME's own code editors use them (§25.1).
  async function keyRules() {
    const { schemes, common, bindingChord } = await import("@EDITOR_WEB@/schemes.js");
    const { commandTable } = await import("@EDITOR_WEB@/commands.js");
    const gnome = {
      "Mod-n": "newFile", "Mod-o": "openFolder", "Mod-s": "save", "Mod-Shift-s": "saveAs", "Mod-w": "closeBuffer",
      "Mod-q": "quit", "Mod-p": "print", "Mod-Shift-p": "printPreview", "Mod-z": "undo", "Mod-Shift-z": "redo",
      "Mod-x": "cut", "Mod-c": "copy", "Mod-v": "paste", "Mod-Shift-v": "pasteSpecial", "Mod-u": "duplicate",
      "Mod-a": "selectAll", "Mod-Shift-a": "selectNone", "Mod-f": "searchForward", "Mod-g": "searchNext",
      "Mod-Shift-g": "searchPrevious", "Mod-h": "replace", "Mod-,": "preferences", "Mod-Shift-/": "showShortcuts",
      "F1": "help", "F5": "refresh", "Mod-r": "refresh", "F9": "toggleFileList", "F10": "menuBar",
      "F11": "fullscreen", "Mod-d": "toggleMark", "Mod-Alt-d": "showMarks", "Mod-l": "enterLocation",
      "Mod-t": "newTab", "Mod-Shift-t": "reopenClosedEditor", "Mod-m": "send", "Mod-=": "zoomIn",
      "Mod--": "zoomOut", "Mod-0": "resetZoom",
    };
    const standard = new Map(Object.entries(gnome).map(([binding, command]) => [bindingChord(binding), command]));
    const cua = { ...common, ...schemes.cua.keys, ...schemes.cua.shown };
    for (const [binding, command] of Object.entries(cua)) {
      const meant = standard.get(bindingChord(binding));
      check(!meant || meant === command, `${binding} is GNOME's key for ${meant}, not ${command}`);
      check(!/^(Shift-)?Alt-[a-zA-Z]$/.test(binding), `${binding} is Alt with a letter, an access key`);
      check(commandTable.some((c) => c.name === command), `${binding} names a command not in the table: ${command}`);
    }
    for (const { name } of commandTable) check(app.commandNames().has(name),
      `${name} is in the table but the window does not run it`);
  }

  // The editor's server (editor-refactor.md §4h.2): started before the client, with the project's root;
  // its lines in the console; its end in the banner, and Retry starts it again; another server is used as it is.
  async function ownServer() {
    emitEvent("server-line", { error: false, text: "espresso-server 0.2.0 listening on 127.0.0.1:57290 (48000 Hz)" });
    check(text(".log").includes("listening on 127.0.0.1:57290"), "the server's lines go to the console");

    // It ends: the banner says why; Retry starts it again and reaches it.
    const starts = serverStarts.length;
    sidecar.status({ connected: false });
    emitEvent("server-exit", { code: 1, line: "espresso-server: cannot open an audio device: none" });
    await until(() => !document.querySelector(".banner").hidden, "the banner for a stopped server");
    check(text(".banner").includes("espresso-server stopped: espresso-server: cannot open an audio device: none"),
          "the banner names the server's last line: " + text(".banner"));
    check(text(".log").includes("espresso-server stopped (status 1)"), "the console says it stopped");
    serverUp = true;
    document.querySelector(".banner button").click();
    await until(() => document.querySelector(".banner").hidden, "Retry to start the server and reach it");
    check(serverStarts.length === starts + 1 && serverStarts.at(-1).root === "/projects/drone",
          "Retry starts the server again with the project's root");

    // Another server has the port: the editor says so, uses it, and starts none of its own after.
    serverAnswer = { state: "exited", code: 1, line: "espresso-server: cannot listen on 127.0.0.1:57290: Address already in use" };
    sidecar.lose();
    await until(() => !document.querySelector(".banner").hidden, "the banner");
    serverUp = true;
    document.querySelector(".banner button").click();
    await until(() => text(".log").includes("another espresso-server has 127.0.0.1:57290; the editor uses it"),
                "the note that another server is used");
    await until(() => document.querySelector(".banner").hidden, "the other server to be reached");
    const after = serverStarts.length;
    await app.openProject("/projects/drone");
    check(serverStarts.length === after, "with another server, the editor starts none of its own");
    row("main.lisp").click();  // the project opened again, with no file open
    await until(() => tab("main.lisp")?.classList.contains("current"), "main.lisp again");
  }

  // The key schemes (tui.md §8.2): each one's Save, Open, Undo, and Quit, and the Emacs table's run keys (§8.5).
  async function keySchemes() {
    document.querySelector('.top [aria-label="Play options"]').click();
    menuRow("Update on Save").click();  // off again: saves below only save
    const doc = () => app.view.state.doc.toString();
    dialogAnswer = null;  // Open's dialog is cancelled, so the project stays open
    // Each scheme saves, opens, undoes, and quits with its own keys.
    const table = async (scheme, { save, open, undo, quit }) => {
      const writes = written("main.lisp").length;
      const dialogsBefore = dialogs;
      const closesBefore = closes;
      app.view.focus();
      app.view.dispatch({ changes: { from: 0, insert: ";" } });
      save();
      await until(() => written("main.lisp").length === writes + 1, `${scheme}: Save`);
      open();
      await until(() => dialogs === dialogsBefore + 1, `${scheme}: Open`);
      app.view.focus();
      const before = doc();
      app.view.dispatch({ changes: { from: 0, insert: "x" }, annotations: isolateHistory.of("full") });  // an undo step of its own
      undo();
      check(doc() === before, `${scheme}: Undo`);
      quit();
      await until(() => closes === closesBefore + 1, `${scheme}: Quit`);
    };

    // The status bar's scheme menu; the choice is remembered and drawn.
    const schemeItem = () => document.querySelector('.status [title="Change key scheme"]');
    check(schemeItem()?.textContent === "CUA", "CUA is the default scheme");
    await table("cua", { save: () => chord("Mod-s"), open: () => chord("Mod-o"), undo: () => chord("Mod-z"),
      quit: () => chord("Mod-q") });

    schemeItem().click();
    menuRow("Emacs").click();
    check(localStorage.getItem("espresso.keys") === "emacs" && schemeItem().textContent === "Emacs", "the scheme is chosen");
    check(document.querySelector(".top .btn.primary").title.endsWith("(C-c C-c)"), "Play's tooltip names Emacs's keys");
    check(stop().title === "Stop (C-c C-s)", "Stop's tooltip names Emacs's keys: " + stop().title);
    await table("emacs", { save: () => chords("C-x C-s"), open: () => chords("C-x C-f"), undo: () => chord("C-/"),
      quit: () => chords("C-x C-c") });
    // §8.5: motion, kill and yank, evaluation, Play and Stop.
    app.view.focus();
    app.view.dispatch({ selection: { anchor: doc().indexOf("(module") + 3 } });
    chord("C-a");
    const lineStart = app.view.state.doc.lineAt(app.view.state.selection.main.head).from;
    check(app.view.state.selection.main.head === lineStart, "C-a: line start");
    chord("C-e");
    check(app.view.state.selection.main.head === app.view.state.doc.lineAt(lineStart).to, "C-e: line end");
    chord("C-a");
    const killed = app.view.state.doc.lineAt(lineStart).text;
    chord("C-k");
    check(app.view.state.doc.lineAt(lineStart).text === "", "C-k kills the line: " + JSON.stringify(app.view.state.doc.lineAt(lineStart).text));
    chord("C-y");
    check(app.view.state.doc.lineAt(lineStart).text === killed, "C-y yanks it back");
    app.view.dispatch({ selection: { anchor: app.view.state.doc.lineAt(lineStart).to } });
    const evals = sent("run.eval").length;
    chords("C-x C-e");
    await until(() => sent("run.eval").length === evals + 1, "C-x C-e");
    check(sent("run.eval").at(-1).params.text === killed, "C-x C-e evaluates the form before the cursor");
    const plays = sent("run.play").length;
    chords("C-c C-c");
    await until(() => sent("run.play").length === plays + 1 && serverStatus.plan > 0, "C-c C-c plays");
    chords("C-c C-s");
    await until(() => sent("run.stop").length > 0 && serverStatus.plan === 0, "C-c C-s stops");
    chords("C-x C-s");  // leave nothing unsaved

    app.setScheme("vim");
    // Vim's command line: ":" opens it in normal mode, and Enter runs what it holds.
    const ex = (command) => {
      app.view.focus();
      chord("S-:");
      const input = document.querySelector(".cm-vim-panel input");
      if (!input) return failures.push("vim: no command line for :" + command);
      input.value = command;
      input.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", code: "Enter", keyCode: 13, bubbles: true, cancelable: true }));
    };
    check(schemeItem().textContent === "Vim · NORMAL", "Vim's mode in the status bar: " + schemeItem().textContent);
    app.view.focus();
    chord("i");
    check(schemeItem().textContent === "Vim · INSERT", "i: insert mode");
    chord("Escape");
    check(schemeItem().textContent === "Vim · NORMAL", "Escape: normal mode");
    await table("vim", { save: () => ex("w"), open: () => ex("e"), undo: () => chord("u"), quit: () => ex("q") });
    const vimPlays = sent("run.play").length;
    ex("play");
    await until(() => sent("run.play").length === vimPlays + 1, ":play");
    ex("w");

    app.setScheme("nano");
    await table("nano", { save: () => chord("C-o"), open: () => chord("C-r"), undo: () => chord("M-u"),
      quit: () => chord("C-x") });
    // nano's cutbuffer: ^K cuts the line and ^U pastes it.
    app.view.focus();
    app.view.dispatch({ selection: { anchor: 0 } });
    const first = app.view.state.doc.line(1).text;
    chord("C-k");
    check(app.view.state.doc.line(1).text !== first, "^K cuts the line");
    chord("C-u");
    check(app.view.state.doc.line(1).text === first, "^U pastes it back");
    chord("C-o");
    await until(() => !tab("main.lisp").classList.contains("unsaved"), "nano's save");

    // Back to CUA.
    app.setScheme("cua");
    check(schemeItem().textContent === "CUA", "back to CUA");
    dialogAnswer = undefined;
  }

  // A keyboard-only walkthrough (design-guide.md §5.6, §5.9, §8.3), in CUA: each overlay opens from its key,
  // works from the keyboard, and gives focus back to where it was.
  async function keyboard() {
    const type = (field, value) => {
      field.value = value;
      field.dispatchEvent(new Event("input", { bubbles: true }));
    };
    const picker = () => document.querySelector(".picker");
    const field = () => document.querySelector(".picker .field");
    const rows = () => [...document.querySelectorAll(".picker .row")];
    const inEditor = () => app.view.contentDOM.contains(document.activeElement);
    const at = () => app.view.state.doc.lineAt(app.view.state.selection.main.head).number;

    // Go to File: the field takes focus; typing narrows the rows; the arrows move the selection; Enter opens.
    app.view.focus();
    chord("Mod-k");
    check(picker() && document.activeElement === field(), "Mod+K opens Go to File with its field focused");
    check(field().getAttribute("role") === "combobox" && document.querySelector(".picker [role=listbox]"),
          "the picker is a combobox over a listbox");
    check(text(".picker .group") === "Recently Opened" && rows()[0].textContent.startsWith("main.lisp"),
          "with no text, the recently opened files first: " + text(".picker .group"));
    type(field(), "tone");
    check(rows().length === 1 && rows()[0].textContent.startsWith("tone.lisp"), "typing narrows the files");
    check(rows()[0].querySelectorAll(".hit").length === 4, "the matched characters are marked");
    type(field(), "l");
    const first = field().getAttribute("aria-activedescendant");
    key("ArrowDown");
    check(field().getAttribute("aria-activedescendant") !== first, "ArrowDown moves the selection");
    key("ArrowUp");
    check(field().getAttribute("aria-activedescendant") === first, "ArrowUp moves it back");
    type(field(), "tone");
    key("Enter");
    await until(() => tab("tone.lisp")?.classList.contains("current"), "Enter to open tone.lisp");
    check(!picker() && inEditor(), "the picker closes, and the editor has focus");

    // "name:line" opens a file at a line; Escape closes the picker and gives focus back.
    chord("Mod-k");
    type(field(), "main.lisp:2");
    key("Enter");
    await until(() => tab("main.lisp")?.classList.contains("current") && at() === 2, "main.lisp at line 2");
    chord("Mod-k");
    key("Escape");
    check(!picker() && inEditor(), "Escape closes the picker, focus back in the editor");

    // Show All Commands: each command with its keys; Enter runs it.
    chord("Mod-Shift-k");
    check(field().value === ">", "Mod+Shift+K opens the commands");
    type(field(), ">toggle side");
    check(rows()[0].textContent.startsWith("Toggle Side Bar") && rows()[0].querySelector("kbd"), "a command with its keys");
    key("Enter");
    check(document.querySelector(".side").hidden, "Enter runs the command");
    await settle();
    check(inEditor(), "focus goes back to the editor");
    key("F9");

    // Go to Line, and a definition by name.
    chord("Mod-i");
    check(field().value === ":" && text(".picker .none").startsWith("Current line: 2"), "Mod+I asks for a line");
    type(field(), ":3");
    key("Enter");
    check(at() === 3 && inEditor(), "Go to Line moves the cursor");
    chord("Mod-k");
    type(field(), "@main");
    check(rows().length >= 1 && rows()[0].textContent.startsWith("main"), "@ lists the file's definitions");
    key("Enter");
    const defined = app.view.state.doc.toString().indexOf("main", app.view.state.doc.toString().indexOf("defpiece"));
    check(app.view.state.selection.main.head === defined, "a definition's row moves to it");
    await settle();

    // Find: the field takes focus and counts; Enter goes to the next match; Escape returns to the text.
    chord("Mod-f");
    const findField = () => document.querySelector(".find .field");
    check(findField() && document.activeElement === findField(), "Mod+F opens find with its field focused");
    type(findField(), "main");
    const total = app.view.state.doc.toString().split("main").length - 1;
    await until(() => text(".find .count").endsWith(`${total}`) || text(".find .count").endsWith(" found"), "the count");
    key("Enter");
    check(app.view.state.sliceDoc(app.view.state.selection.main.from, app.view.state.selection.main.to) === "main",
          "Enter selects the next match");
    check(/^\d+ of \d+$/.test(text(".find .count")), "the count names the current match: " + text(".find .count"));
    document.querySelector('.find [aria-label="Match case"]').click();
    check(document.querySelector('.find [aria-label="Match case"]').getAttribute("aria-pressed") === "true", "Match case toggles");
    findField().focus();
    key("Escape");
    check(!document.querySelector(".find") && inEditor(), "Escape closes find, focus back in the editor");

    // Replace: Mod+H opens the second row; Replace All changes every match, and undo restores them.
    const before = app.view.state.doc.toString();
    chord("Mod-h");
    const replaceField = document.querySelector('.find [aria-label="Replace"]');
    check(replaceField && document.activeElement === replaceField, "Mod+H opens replace with its field focused");
    type(findField(), "defpiece");
    type(replaceField, "defpiece");
    [...document.querySelectorAll(".find button")].find((b) => b.textContent === "Replace All").click();
    check(app.view.state.doc.toString() === before, "Replace All with the same text changes nothing");
    type(replaceField, "DEFPIECE");
    [...document.querySelectorAll(".find button")].find((b) => b.textContent === "Replace All").click();
    check(app.view.state.doc.toString() === before.replaceAll("defpiece", "DEFPIECE"), "Replace All replaces every match");
    app.view.focus();
    chord("Mod-z");
    check(app.view.state.doc.toString() === before, "undo restores them");
    document.querySelector('.find [aria-label="Close (Escape)"]').click();

    // Escape, then Tab, leaves the editor; Tab alone indents.
    app.view.focus();
    const text0 = app.view.state.doc.toString();
    key("Tab");
    check(app.view.state.doc.toString() !== text0, "Tab indents in the editor");
    chord("Mod-z");
    app.view.dispatch({ selection: { anchor: 0 } });  // the first Escape would drop a selection
    key("Escape");
    key("Tab");
    check(app.view.state.doc.toString() === text0, "after Escape, Tab leaves the text alone, for focus to move");

    // Ctrl+?: Keyboard Shortcuts, from the scheme's table, by menu; About from the main menu; Escape closes each.
    chord("Mod-Shift-/");
    check(text(".dialog h2") === "Keyboard Shortcuts: CUA" && document.querySelectorAll(".shortcuts .row").length > 10,
          "Ctrl+? shows the scheme's shortcuts");
    check([...document.querySelectorAll(".shortcuts .group")].map((g) => g.textContent).join(",")
          === "General,File,Edit,Selection,View,Go,Play", "grouped by the menus, General first, a menu without keys left out: "
          + [...document.querySelectorAll(".shortcuts .group")].map((g) => g.textContent).join(","));
    key("Escape");
    check(!document.querySelector(".scrim") && inEditor(), "Escape closes Keyboard Shortcuts");
    app.runCommand("showAbout");
    check(text(".dialog").includes("Client test · protocol 1 · IR metadata 0.7.0"), "About names the versions: " + text(".dialog"));
    key("Escape");
    check(!document.querySelector(".scrim"), "Escape closes About");

    // The status bar's position opens Go to Line; the command center opens Go to File.
    [...document.querySelectorAll(".status .item")].find((i) => i.textContent.startsWith("Ln ")).click();
    check(field()?.value === ":", "the position opens Go to Line");
    key("Escape");
    document.querySelector(".command-center").click();
    check(picker() && field().value === "", "the command center opens Go to File");
    key("Escape");
  }

  // §8.1: the theme's text, each against its ground, at least 4.5:1 (WCAG 2.2, 1.4.3).
  function contrast() {
    const root = getComputedStyle(document.documentElement);
    const rgb = (name) => {
      const hex = root.getPropertyValue(name).trim().replace("#", "");
      return [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
    };
    const luminance = (c) => {
      const [r, g, b] = c.map((v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
      return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    };
    const ratio = (a, b) => {
      const [x, y] = [luminance(rgb(a)), luminance(rgb(b))].sort((p, q) => q - p);
      return (x + 0.05) / (y + 0.05);
    };
    const pairs = [
      ["--text", "--window"], ["--bright", "--window"], ["--secondary", "--chrome"], ["--secondary", "--side"],
      ["--secondary", "--box"], ["--secondary", "--field"], ["--lineNumberText", "--window"], ["--text", "--side"],
      ["--statusBarText", "--statusBar"], ["--onAccent", "--accent"], ["--onTabActive", "--tabActive"],
      ["--bright", "--field"], ["--bright", "--box"], ["--accentText", "--box"], ["--accentText", "--side"],
      ["--error", "--window"], ["--error", "--side"], ["--error", "--box"], ["--window", "--accentText"],
      ...["--codeSpecialForm", "--codeKeyword", "--codeCall", "--codeString", "--codeNumber", "--codeQuotedSymbol",
        "--codeSymbol", "--codeComment"].flatMap((c) => [[c, "--window"], [c, "--lineCurrent"]]),
    ];
    for (const [fore, ground] of pairs) {
      const r = ratio(fore, ground);
      check(r >= 4.5, `${fore} on ${ground} is ${r.toFixed(2)}:1, under 4.5:1`);
    }
  }

  // §6.1, §8.3: every control the keyboard reaches has a name.
  function names() {
    const focusable = [...document.querySelectorAll("button, input, a[href], [tabindex]")]
      .filter((e) => !e.disabled && e.tabIndex >= 0 && e.offsetParent !== null);
    check(focusable.length >= 15, "the window's controls are reachable: " + focusable.length);
    for (const e of focusable) {
      const name = e.getAttribute("aria-label") || e.textContent.trim() || e.getAttribute("placeholder");
      check(name, "a control without a name: " + e.outerHTML.slice(0, 120));
    }
    for (const img of document.querySelectorAll("img")) check(img.hasAttribute("alt"), "an image without alt text");
  }

  async function screenshot(state) {
    await until(() => text(".status").includes("espresso-server"), "the status");
    if (state === "empty") return;
    [...document.querySelectorAll(".empty button")].find((b) => b.textContent === "Open Folder…").click();
    await until(() => row("loops.lisp"), "the files");
    row("marimba.lisp").click();
    await until(() => tab("marimba.lisp"), "marimba.lisp");
    row("main.lisp").click();
    await until(() => tab("main.lisp"), "main.lisp");
    row("loops.lisp").click();
    await until(() => tab("loops.lisp")?.classList.contains("current"), "loops.lisp");
    const doc = () => app.view.state.doc;
    const line = doc().line(Math.min(84, doc().lines));
    app.view.dispatch({ changes: { from: line.from, insert: " " } });
    app.view.dispatch({ selection: { anchor: doc().line(84).to }, scrollIntoView: true });
    app.addLog({ kind: "info", text: "server: connected to espresso-server 0.2.0 at 127.0.0.1:57290 (48000 Hz, 256-sample blocks)" });
    app.addLog({ kind: "info", text: "compiled main.lisp: 214 nodes, 96 pipes" });
    const location = { path: "loops.lisp", line: 82, column: 44 };
    app.addLog({ kind: "error", text: "loops.lisp:82:44: mapper expects a pipe, got the number 50", location });
    if (state === "eval") {
      const { formAt } = await import("@EDITOR_WEB@/lisp.js");
      const { markEvaluated } = await import("@EDITOR_WEB@/codeEditor.js");
      const range = formAt(doc().toString(), doc().line(84).from + 4);
      app.view.dispatch(markEvaluated(range));
      app.addLog({ kind: "info", text: "eval loops.lisp:72:1: read (define (pattern-loop ticks freqs held fill notes) …)" });
    }
    if (state === "lost") sidecar.lose();
    if (state === "server") document.querySelector(".status .item").click();
    if (state === "files") app.openPicker("");
    if (state === "commands") app.openPicker(">");
    if (state === "find") {
      const ticks = doc().toString().indexOf("ticks", doc().line(73).from);
      app.view.dispatch({ selection: { anchor: ticks, head: ticks + 5 }, scrollIntoView: true });
      app.runCommand("searchForward");
      document.querySelector(".find .field").blur();
    }
    if (state === "shortcuts") app.runCommand("showShortcuts");
    if (state === "complete") {
      const at = doc().line(84).to;
      app.view.focus();
      app.view.dispatch({ changes: { from: at, insert: "\n    (sine-osc :" }, selection: { anchor: at + 16 }, userEvent: "input.type" });
      await until(() => document.querySelector(".cm-tooltip-autocomplete li"), "the completion list");
    }
    if (state === "marks") {
      const { setMarks } = await import("@EDITOR_WEB@/marks.js");
      app.view.dispatch({ effects: setMarks.of([doc().line(78).from, doc().line(82).from]) });
    }
    if (state === "fold") {
      app.view.dispatch({ selection: { anchor: doc().line(72).from }, scrollIntoView: true });
      app.runCommand("fold");
    }
    if (state === "page" || state === "tear") sidecar.status({ plan: 2, page: 8000 });  // a server playing page-keys serves it
    if (state === "tear") {
      // The page's tab held beyond the strip, before the drop.
      await until(() => document.querySelector(".tab.page-tab"), "the page's tab");
      const box = document.querySelector(".tab.page-tab").getBoundingClientRect();
      const pointer = (type, target, x, y) => target.dispatchEvent(new PointerEvent(type, {
        pointerId: 1, button: 0, clientX: x, clientY: y, bubbles: true, cancelable: true }));
      pointer("pointerdown", document.querySelector(".tab.page-tab"), box.x + 20, box.y + 15);
      pointer("pointermove", window, box.x + 160, box.y + 260);
    }
    if (state === "schemes") document.querySelector('.status [title="Change key scheme"]').click();
    if (state === "vim") {
      app.setScheme("vim");
      app.view.focus();
      app.view.contentDOM.dispatchEvent(new KeyboardEvent("keydown", { key: ":", code: "Semicolon", shiftKey: true,
        bubbles: true, cancelable: true }));
      const input = document.querySelector(".cm-vim-panel input");
      if (input) input.value = "play";
    }
    if (state === "editor") {
      // F8 goes to the problem and shows its hover, as a pointer over it would.
      app.view.focus();
      app.view.contentDOM.dispatchEvent(new KeyboardEvent("keydown", { key: "F8", bubbles: true, cancelable: true }));
    }
  }

  try {
    if (shot) await screenshot(shot);
    else await test();
  } catch (e) {
    if (e !== stopped) failures.push("threw: " + (e.stack ?? e));
  }
  result.textContent = failures.length === 0 ? "editor: ok" : "editor: FAIL " + failures.join("; ");
</script>
</body>
</html>
