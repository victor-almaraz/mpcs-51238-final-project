# Writes OUT, a C++ source defining NAMESPACE::FUNCTION(), which returns
# the text of IN as a std::string_view: a file served or used as it is,
# such as the page helper (io.md §12.9). Run with cmake -P; the file is
# rewritten only when its contents change.

set(delimiter "espresso-text")
file(READ "${IN}" text)
string(FIND "${text}" ")${delimiter}\"" clash)
if(NOT clash EQUAL -1)
    message(FATAL_ERROR "${IN} contains )${delimiter}\", which ends the literal that embeds it")
endif()
get_filename_component(name "${IN}" NAME)
file(WRITE "${OUT}.tmp"
"// Generated by cmake/EmbedText.cmake from ${name}; do not edit.

#include <string_view>

namespace ${NAMESPACE} {

std::string_view ${FUNCTION}() {
    return R\"${delimiter}(${text})${delimiter}\";
}

} // namespace ${NAMESPACE}
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
